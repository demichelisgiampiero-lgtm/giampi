+def _motivo_afferma_riproduzione(motivo: str) -> bool:
+    """Il motivo sostiene che il contenuto sta gia' altrove?
+
+    Non e' un giudizio sulla qualita' del motivo: e' il riconoscimento di
+    un'AFFERMAZIONE, che in quanto tale va provata. «Ho letto solo le tabelle di
+    bilancio» non dice nulla del resto ed e' una scelta; «riproduce il parere
+    627» dice che il resto e' gia' noto, ed e' una tesi.
+    """
+    if not motivo:
+        return False
+    t = unicodedata.normalize("NFKD", motivo)
+    t = "".join(c for c in t if not unicodedata.combining(c)).casefold()
+    # Gli apostrofi vanno tolti prima del confronto: senza, «gia' letto» non
+    # combaciava con la spia «gia letto» e passava liscio. E' la forma che i
+    # lettori usano piu' spesso, perche' il plugin vieta le lettere accentate.
+    t = re.sub(r"[\u0027\u2019\u02bc`]+", "", t)
+    t = re.sub(r"\s+", " ", t)
+    return any(spia in t for spia in RIPRODUZIONE_AFFERMATA)
+
